# Public Supabase config exposed to the browser.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional server-side override for local/testing fallback. Use "auto" in deployed environments.
NUXT_CMS_MODE=auto

# Private server-only Supabase key. Never expose this in client code.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Private comma-separated admin email allowlist for CMS access.
NUXT_ADMIN_EMAILS=admin@example.com
